        <widget class="QSlider" name="verticalSlider">
         <property name="styleSheet">
          <string notr="true">/* 1. КОНТЕЙНЕР СЛАЙДЕРА */
QSlider:vertical {
    min-width: 48px;                  
}

/* 2. ДОРІЖКА (Грув) */
QSlider::groove:vertical {
    width: 36px;                      
    background-color: #087ce8;   
    border: 1px solid #2b5b72;
    /* Повне закруглення з усіх боків (36px / 2) */
    border-radius: 18px;              
    margin: 0px;                      
}

/* 3. АКТИВНА ЧАСТИНА (Нижня частина доріжки під повзунком) */
QSlider::sub-page:vertical {
    background-color: #06131c;   
    border: none;
    /* Закругляємо ВСІ 4 кути, щоб при піднятті повзунка вгору 
       темний колір не перекривав закруглений верхній край доріжки */
    border-radius: 17px;   
}

/* 4. НЕАКТИВНА ЧАСТИНА (Верхня частина доріжки над повзунком) */
QSlider::add-page:vertical {
    background-color: transparent;
    border: none;
    /* Закругляємо про всяк випадок, якщо захочеться змінити transparent на інший колір */
    border-radius: 17px;
}

/* 5. ПОВЗУНОК */
QSlider::handle:vertical {
    height: 30px;                     
    width: 48px;                      
    margin: 0px -6px;                 
    background-color: #e5f2ff;
    border: 1px solid #9fcfff;
    border-radius: 15px;              
}</string>
         </property>
         <property name="maximum">
